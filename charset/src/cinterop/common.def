depends = posix
package = platform.binomiconv
headers = iconv.h
headerFilter = NOTHING
linkerOpts = -liconv
---
//#include <iconv.h>

iconv_t binom_iconv_open(const char* tocode, const char* fromcode){
    return iconv_open(tocode, fromcode);
}

int binom_iconv_close(iconv_t cd){
    return iconv_close(cd);
}

long long binom_iconv(iconv_t cd,
            void **restrict inbuf, long long *restrict inbytesleft,
            void **restrict outbuf, long long *restrict outbytesleft){
            size_t *restrict _inbytesleft;
            size_t *restrict _outbytesleft;
    size_t res = iconv(cd,inbuf,_inbytesleft,outbuf,_outbytesleft);
    *inbytesleft=_inbytesleft;
    *outbytesleft=_outbytesleft;
    return res;
}
